# URL base do lumina-backend (FastAPI)
# Em produção, aponte para o HF Space / servidor onde a API está publicada.
VITE_API_URL=http://localhost:8000

# true = liga o modo simulação por padrão (esteira local, sem chamar a API).
# Útil para desenvolver o front-end com o backend ainda offline.
VITE_DEMO_MODE=false
